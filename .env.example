# ───────── Banco de dados ─────────
# Postgres (Supabase, Neon, RDS…). Sem esta variável o app usa PGlite (Postgres embutido)
# salvo em .data/pglite: bom para uso local, NÃO para produção serverless.
DATABASE_URL=
# SSL do Postgres: vazio = automático (sem verificação de certificado fora do localhost),
# "strict" = verifica o certificado, "disable" = sem SSL.
DATABASE_SSL=
# Migrações rodam sozinhas na primeira conexão (com lock). Use "false" para rodar só com `npm run db:migrate`.
DB_AUTO_MIGRATE=

# ───────── Google Maps Platform ─────────
# Chave de SERVIDOR com a "Places API (New)". Sem ela: modo demonstração (empresas fictícias).
GOOGLE_MAPS_API_KEY=
# Chave de NAVEGADOR (Maps JavaScript API), restrita ao seu domínio. Sem ela: mapa esquemático.
GOOGLE_MAPS_BROWSER_KEY=

# ───────── App ─────────
# URL pública, usada nos links de convite (ex.: https://prospecta.seudominio.com).
APP_URL=
# Fuso dos gráficos do dashboard.
APP_TIMEZONE=America/Sao_Paulo
# Dias que os dados lidos dos sites das empresas ficam em cache.
ENRICHMENT_CACHE_DAYS=14

# ───────── Planos ─────────
# "test" (padrão): troca de plano aplicada na hora, sem cobrança.
# "disabled": ninguém troca de plano pela interface.
BILLING_MODE=test
