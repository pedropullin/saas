# Chave de SERVIDOR da Google Maps Platform com a "Places API (New)" ativada.
# Fica só no servidor. Sem ela o site roda em MODO DEMONSTRAÇÃO, com empresas fictícias.
GOOGLE_MAPS_API_KEY=

# Chave de NAVEGADOR para desenhar o mapa (Maps JavaScript API).
# Restrinja por "Referenciadores HTTP" ao seu domínio e só à Maps JavaScript API.
# Sem ela, o app mostra um mapa esquemático no lugar do Google Maps.
GOOGLE_MAPS_BROWSER_KEY=

# Códigos de acesso para você e seus amigos, separados por vírgula.
# Quando preenchido, /prospectar e /lista pedem nome + código.
# Deixe vazio só para uso local: sem código, qualquer pessoa usa sua cota do Google.
PROSPECTA_ACCESS_CODES=

# Segredo para assinar o cookie de sessão (qualquer texto longo e aleatório).
# Gere com: openssl rand -hex 32
PROSPECTA_SESSION_SECRET=
